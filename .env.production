# ============================================
# 生产环境配置
# ============================================

# 生产环境默认关闭 Mock，对接真实 SpringBoot 后端
VITE_USE_MOCK=false

# 生产环境接口前缀（部署时请改为后端实际地址，如 https://api.example.com/api）
VITE_API_BASE_URL=/api

# 登录注册接口对接地址（完整的真实后端地址，为空时使用 VITE_API_BASE_URL）
VITE_API_SERVER_URL=
