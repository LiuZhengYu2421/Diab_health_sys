# ============================================
# 开发环境配置
# ============================================

# 是否启用本地 Mock 模式：
#   true  -> 使用 localStorage 本地模拟用户库，无需后端即可运行演示
#   false -> 请求真实后端接口（对接 SpringBoot）
VITE_USE_MOCK=true

# SpringBoot 后端接口前缀（VITE_USE_MOCK=false 时生效）
# 例如后端部署在 http://localhost:8080，则请求 http://localhost:8080/api/auth/login
VITE_API_BASE_URL=/api

# 登录注册接口对接地址（完整的真实后端地址，为空时使用 VITE_API_BASE_URL）
VITE_API_SERVER_URL=
